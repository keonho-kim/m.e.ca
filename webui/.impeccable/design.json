      "html": "<button class=\"ds-button-primary\" type=\"button\">저장</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;box-sizing:border-box;height:32px;padding:.5rem .75rem;border:0;border-radius:var(--radius-element,.625rem);font:500 .875rem/1.4286 var(--font-family-body,system-ui);cursor:pointer;transition:background-color var(--duration-fast,130ms) var(--ease-standard,cubic-bezier(.24,1,.4,1)),transform var(--duration-fast,130ms) var(--ease-standard,cubic-bezier(.24,1,.4,1));background:var(--color-accent,light-dark(#171717,#f5f5f5));color:var(--color-on-accent,light-dark(#ffffff,#171717));}.ds-button-primary:hover{background-image:linear-gradient(var(--color-overlay-hover,light-dark(#0000000D,#ffffff0D)),var(--color-overlay-hover,light-dark(#0000000D,#ffffff0D)));}.ds-button-primary:focus-visible{outline:2px solid var(--color-accent,light-dark(#171717,#f5f5f5));outline-offset:3px;}.ds-button-primary:active{background-image:linear-gradient(var(--color-overlay-pressed,light-dark(#0000001A,#ffffff1A)),var(--color-overlay-pressed,light-dark(#0000001A,#ffffff1A)));}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
