      "css": ".ds-field{display:grid;gap:.5rem;font-family:var(--font-family-body,system-ui);color:var(--color-text-primary,light-dark(#171717,#f5f5f5));}.ds-field-label{font-size:.875rem;font-weight:500;line-height:1.4286;}.ds-field-control{display:flex;padding:.25rem .5rem;border:1px solid var(--color-border-emphasized,light-dark(#d4d4d4,#525252));border-radius:var(--radius-element,.625rem);background:var(--color-background-surface,light-dark(#ffffff,#141414));transition:border-color var(--duration-fast,130ms),box-shadow var(--duration-fast,130ms);}.ds-field-control:hover:not(:focus-within){box-shadow:inset 0 0 0 2px color-mix(in srgb,var(--color-border-emphasized,light-dark(#d4d4d4,#525252)) 30%,transparent);}.ds-field-control:focus-within{border-color:var(--color-accent,light-dark(#171717,#f5f5f5));box-shadow:inset 0 0 0 2px var(--color-accent-muted,light-dark(rgb(0 0 0 / 6%),rgb(255 255 255 / 10%)));}.ds-field-input{width:100%;min-width:0;height:32px;padding:0;border:0;outline:none;background:transparent;color:inherit;font:400 .875rem/1.4286 var(--font-family-body,system-ui);}.ds-field-input::placeholder{color:var(--color-text-secondary,light-dark(#666666,#aaaaaa));}@media(prefers-reduced-motion:reduce){.ds-field-control{transition:none;}}@media(pointer:coarse){@supports(-webkit-touch-callout:none){.ds-field-input{font-size:1rem;}}}"
