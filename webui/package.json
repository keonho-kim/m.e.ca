{
  "name": "meca-webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "analyze": "bun run check && bun --bun vite build --mode analyze",
    "build": "bun run check && bun run quality && bun --bun vite build && bun scripts/package.ts",
    "check": "bun run theme && tsc -b --pretty false",
    "test": "bun test src",
    "lint": "biome check src scripts *.ts",
    "browser": "playwright-cli",
    "test:e2e": "playwright test",
    "astryx": "bun --bun node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "theme": "bun run astryx theme build src/app/styles/theme.ts --out src/app/styles/generated/meca.css",
    "architecture": "bun --bun node_modules/steiger/dist/cli.mjs ./src",
    "lint:types": "bun --bun node_modules/oxlint/bin/oxlint --type-aware src scripts e2e *.ts",
    "deadcode": "bun --bun node_modules/knip/bin/knip.js --no-progress",
    "quality": "bun run lint && bun run lint:types && bun run deadcode && bun run architecture",
    "verify": "bun run check && bun run quality && bun run test",
    "generate:api": "protoc -I ../api --plugin=protoc-gen-es=node_modules/.bin/protoc-gen-es --es_out=src/shared/api/gen --es_opt=target=ts,json_types=true ../api/meca/v1/*.proto"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.13",
    "@astryxdesign/theme-neutral": "0.7.13",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@hookform/resolvers": "7.0.5",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.26",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-simple-code-editor": "0.14.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.13",
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.6.6",
    "@bufbuild/protobuf": "2.17.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@playwright/cli": "0.1.24",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "knip": "6.45.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "rollup-plugin-visualizer": "7.1.3",
    "steiger": "0.10.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "imports": {
    "#build/notices": "./scripts/notices.ts"
  },
  "patchedDependencies": {
    "react-simple-code-editor@0.14.1": "patches/react-simple-code-editor@0.14.1.patch"
  }
}
