# Purpose: Exclude generated artifacts, private local state and editor/OS files.
# Pattern: Repository Configuration.
# Usage: Read by Git when inspecting this project.
# Related: docs/development.md, webui/playwright.config.ts, scripts/build-ui.sh.

# Local agent instructions and design-tool state
AGENTS.md
.hallmark/
.impeccable/
/.codex/
/.claude/
/.local/
/docs/internal/

# Go build and release output
/bin/
/dist/
/meca
/v
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Test coverage and profiling output; keep fixture .out files trackable
/coverage/
/coverage*.out
/coverage*.html
/coverage*.txt
/cover.out
/cover.html
*.coverprofile
*.pprof
*.prof

# Local Go workspace overrides and caches; commit go.mod and go.sum
/go.work
/go.work.sum
/.cache/
/.gocache/

# Embedded UI source dependencies and reproducible build output
/node_modules/
/webui/node_modules/
/webui/.vite/
/webui/dist/
*.tsbuildinfo
/webui/coverage/
/webui/test-results/
/webui/playwright-report/
/webui/blob-report/
/test-results/
/playwright-report/
/blob-report/
/webui/.playwright-cli/
/.playwright-cli/
/internal/webui/bundle_generated.go
/internal/webui/.meca-ui-*.tmp
/webui/.cache/

# Browser authentication snapshots are private, not test fixtures.
/playwright/.auth/
/webui/playwright/.auth/
/webui/.auth/
/.auth/
/auth.json
/storage-state.json
/webui/auth.json
/webui/storage-state.json

# Temporary directories and runtime diagnostics
/real-world-test/
/tmp/
/temp/
/.tmp/
/logs/
/*.log
/*.pid
/*.tmp
/webui/*.tmp
/webui/*.log
/webui/*.pid

# Private application state and accidental copies of user credentials
/.meca/
/meca.db
/meca.db-*
/.v/
/v.db
/v.db-*
/credentials
/credentials.key
/.secrets/
/config.local.toml
/config.local.toml.*
!/config.local.toml.example
!/config.local.toml.sample
/server.token
/credentials.db
/credentials.db-*
/connection.json
/connection.json.stop
/webui/connection.json
/webui/connection.json.stop
# Root-level local TLS/signing material; fixture directories stay trackable.
/*.key
/*.pem
/*.p12
/*.pfx
/webui/*.key
/webui/*.pem
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# IDE state; keep shared VS Code tasks, launch settings and recommendations
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace
.history/

# Editor swap, backup and lock files
*.swp
*.swo
*~
\#*\#
.#*

# macOS filesystem metadata
.DS_Store
.DS_Store?
._*
.AppleDouble/
.LSOverride
.Spotlight-V100/
.Trashes/
.fseventsd/

# Windows filesystem metadata
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Built Astryx theme descriptors are regenerated before browser type checks and builds.
/webui/src/app/styles/generated/

# Generated Material glyphs are compiled from the pinned build dependency.
/webui/src/shared/ui/file-icon/generated.tsx
